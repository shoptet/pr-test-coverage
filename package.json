{
  "name": "pr-test-coverage",
  "version": "1.0.5",
  "description": "A Github Action to report the test coverage of changed files in a pull request",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "github-action",
    "test-coverage",
    "clover",
    "pull-request"
  ],
  "author": "Jordan Baczuk",
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^2.1.7",
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vercel/ncc": "^0.38.1",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
